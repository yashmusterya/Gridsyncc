# Secret used to sign session tokens (HMAC-SHA256). REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server falls back to a random per-process secret, which means
# every cold start invalidates all sessions and signs users out.
SESSION_SECRET=

# Google Maps JavaScript API key (Places + Geometry libraries).
# Served to the client via /api/config - restrict it by HTTP referrer to your
# Vercel domain(s) in Google Cloud Console, since Maps JS API keys are always
# visible to the browser regardless of how they're delivered.
GOOGLE_MAPS_API_KEY=

# Open Charge Map API key: https://openchargemap.org/site/develop/api
# Optional - the OCM public API also works unauthenticated, just with a lower quota.
OCM_API_KEY=

# India Energy Atlas / SLDC live grid demand & frequency API key.
# Optional - falls back to simulated Maharashtra grid data if left blank.
ATLAS_API_KEY=

# Supabase project (optional but recommended). Enables persistent storage for
# users/auth, saved trips, community reports, and admin overrides, instead of
# the in-memory fallback store, which resets whenever the serverless function
# cold-starts on Vercel.
#
# Setup:
#   1. Create a Supabase project, then run supabase/schema.sql in its SQL Editor.
#   2. Set SUPABASE_URL to the project URL and SUPABASE_KEY to the
#      `service_role` key (Project Settings -> API) - NOT the anon key. The
#      server writes on behalf of all users, so it needs to bypass RLS the
#      same way the anon/browser client never should. Never expose this key
#      to the browser.
#   3. Run `node scripts/seed-supabase.js` once to seed the two demo accounts
#      (user@gridsync.in / admin@gridsync.in) with properly hashed passwords.
SUPABASE_URL=
SUPABASE_KEY=
